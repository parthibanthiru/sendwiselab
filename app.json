{
  "expo": {
    "name": "SendWiseLab",
    "slug": "sendwiselab",
    "scheme": "sendwiselab",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sendwiselab.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.sendwiselab.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D252D"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1D252D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/sendwiselab"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    }
  }
}
