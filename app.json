{
  "expo": {
    "name": "Money Transfer",
    "slug": "money-transfer",
    "scheme": "moneytransfer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.moneytransfer.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.moneytransfer.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D252D"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1D252D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
