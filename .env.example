# Copy this file to .env and fill in the values.
# Supabase → Project Settings → API. Use a NEW project for SendWiseLab (EU / Frankfurt region),
# not the Finanzpal one: accounts and payment data stay separate.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
